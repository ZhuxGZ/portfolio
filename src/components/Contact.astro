---
import Wrapper from "./Wrapper.astro";
import EmailSvg from "./svg/EmailSvg.astro";
---

<Wrapper>
	<div class="text-center">
		<p class="text-muted font-mono text-base!">Contact</p>
		<h2 class="mb-6">Get in touch</h2>
		<p class="text-muted font-mono text-base!">I'm always open to new opportunities and collaborations. Feel free to reach out if you have any questions or would like to chat.</p>
		<button class="items-center gap-2 mt-8 border-2 border-border bg-card hover:bg-accent rounded-lg py-2 px-4"><a class="flex items-center gap-2 font-bold! text-sm" href="mailto:bergantinos.ignacio@gmail.com"><EmailSvg /> Say hello</a></button>
	</div>
</Wrapper>
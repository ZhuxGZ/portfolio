---
import Tag from "./Tag.astro";
import GithubSvg from './svg/GithubSvg.astro';
const { title, description, link, date, skills } = Astro.props;
---

<div class="border-2 border-border rounded-lg p-4">
	<div class="flex justify-between items-center mb-4"><h3 class="mb-1 text-sm! font-mono font-semibold text-foreground">{title}</h3><div class={link ? "" : "hidden"}><a class="text-muted hover:text-foreground transition-colors" target="_blank" href={link}><GithubSvg /></a></div></div>
	<p class="mt-2 mb-4 text-sm text-muted font-mono">{description}</p>
	<div class="flex gap-2 flex-wrap">
		{skills.map((skill: string) => <Tag>{skill}</Tag>)}
	</div>
</div>
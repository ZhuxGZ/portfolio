---
import LinkedinSvg from './LinkedinSvg.astro';
import GithubSvg from './GithubSvg.astro';
import Wrapper from "./Wrapper.astro";
---
	<div class="w-full h-[calc(100dvh-104px)] sm:hidden">
		<nav>
			<Wrapper className="pb-[calc(90dvh-218px)] flex flex-col gap-4 text-xl">
				<a class="text-muted" href="/">Home</a>
				<a class="text-muted" href="/projects">Projects</a>
				<a class="text-muted" href="/blog">Blog</a>
			</Wrapper>
			<Wrapper className="flex justify-center items-center gap-5">
				<LinkedinSvg class="w-8 h-8" />
				<GithubSvg class="w-8 h-8" />	
			</Wrapper>
		</nav>
	</div>

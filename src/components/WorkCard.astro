---
import Tag from "./Tag.astro";
import LinkSvg from "./LinkSvg.astro";
const { title, company, role, description, link, date } = Astro.props;
---

<div class="border-2 border-border rounded-lg p-4">
	<div class="flex justify-between items-center mb-4"><div class="flex items-center"><span class="text-sm text-foreground">{company}</span><span class="ml-2 text-xs text-muted font-mono">{date}</span></div><div class={link ? "" : "hidden"}><a target="_blank" href={link}><LinkSvg /></a></div></div>
	<h3 class="mb-1 text-lg font-semibold text-foreground">{title}</h3>
	<p class="mb-1 text-sm text-muted font-mono">{role}</p>
	<p class="mt-2 mb-4 text-sm text-muted font-mono">{description}</p>
	<div class="flex gap-2">
		<Tag>TypeScript</Tag>
		<Tag>React</Tag>
		<Tag>React</Tag>
		<Tag>React</Tag>
	</div>
</div>
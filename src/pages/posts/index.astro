---
import Layout from "../../layouts/Layout.astro";
import Wrapper from "../../components/Wrapper.astro";
import Tag from "../../components/Tag.astro";
const posts = Object.values(import.meta.glob('./*.md', { eager: true }));
console.log(posts[0].url)
---

<Layout>
	<Wrapper>
		<p class="text-muted font-mono text-base!">Blog</p>
		<h2 class="mb-6">Recent Writing</h2>
		<div>
			{posts.map((post) => (
				<a href={post.url}>
					<p class="text-muted font-mono text-sm!">{post.frontmatter.date}</p>
					<h3>{post.frontmatter.title}</h3>
					<p>{post.frontmatter.description}</p>
					<ul class="flex gap-2 mt-2">
						{post.frontmatter.tags.map((tag: string) => (
							<Tag>{tag}</Tag>
						))}
					</ul>
				</a>
			))}
		</div>
	</Wrapper>
</Layout>